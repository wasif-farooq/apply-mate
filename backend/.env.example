# --- Required. The app refuses to start without these. ---
DATABASE_URL=postgresql://applymate:changeme@localhost:5432/applymate
JWT_SECRET=generate-with-openssl-rand-base64-32
# Alibaba Cloud Model Studio (DashScope). One key for the whole deployment --
# there is no per-user AI configuration.
DASHSCOPE_API_KEY=sk-xxxx

# --- AI, optional overrides ---
# International (Singapore) endpoint. Use https://dashscope.aliyuncs.com/compatible-mode/v1
# for the mainland China console.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.5-flash
# json_object works on the flash tiers. json_schema needs a plus/max model.
AI_STRUCTURED_MODE=json_object
AI_MAX_REVISIONS=2
AI_TIMEOUT_SECONDS=90

# --- App ---
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
JSON_LOGS=false

# --- Google OAuth (sign-in; unrelated to the AI provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXTENSION_GOOGLE_CLIENT_ID=
EXTENSION_GOOGLE_CLIENT_SECRET=

# --- Gmail sending ---
GMAIL_SENDER_NAME=Your Name
