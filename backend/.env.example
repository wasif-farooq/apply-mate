# --- Required. The app refuses to start without these. ---
DATABASE_URL=postgresql://applymate:changeme@localhost:5432/applymate
JWT_SECRET=generate-with-openssl-rand-base64-32
# One key for the whole deployment -- there is no per-user AI configuration.
AI_API_KEY=sk-xxxx

# --- AI, optional overrides ---
# Any OpenAI-compatible endpoint. Model ids for OpenCode Zen are listed at
# https://opencode.ai/zen/v1/models (no auth needed to read it).
#   Alibaba DashScope: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=https://opencode.ai/zen/v1
AI_MODEL=laguna-s-2.1-free
# prompt | json_object | json_schema -- see core/config.py. "prompt" asks for
# nothing the provider might reject and validates the reply here.
AI_STRUCTURED_MODE=prompt
AI_MAX_REVISIONS=2
AI_TIMEOUT_SECONDS=90

# --- App ---
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
JSON_LOGS=false

# --- Google OAuth (sign-in; unrelated to the AI provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXTENSION_GOOGLE_CLIENT_ID=
EXTENSION_GOOGLE_CLIENT_SECRET=

# --- Gmail sending ---
GMAIL_SENDER_NAME=Your Name
